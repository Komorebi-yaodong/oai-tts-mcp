# 将以下变量填写到 MCP 客户端的 env 配置中；不要把真实 Key 提交到 Git。
# 支持 https://api.openai.com 或 https://api.openai.com/v1；程序会自动规整为单个 /v1。
OAI_TTS_BASE_URL=https://api.openai.com/v1

# 必填：真实值只应保存在本机客户端配置或受保护的环境变量中。
OAI_TTS_API_KEY=your_api_key_here

# 必填：推荐 gpt-4o-mini-tts，它支持 instructions 控制语气、情绪、节奏和表达方式。
OAI_TTS_MODEL=gpt-4o-mini-tts

# 必填：text_to_speech 未传 voice 时使用此默认音色。
OAI_TTS_VOICE=marin

# 可选：Urusai 图床访问令牌。生成的音频将上传到第三方并返回公开 URL；请勿上传敏感内容。
URUSAI_API_TOKEN=your_optional_urusai_token

# 可选：默认 https://api.urusai.cc/v1/upload。仅供自建兼容上传服务或本机测试覆盖使用。
URUSAI_UPLOAD_URL=https://api.urusai.cc/v1/upload

