{
  "name": "oai-tts-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "An OpenAI-compatible text-to-speech MCP server with voice discovery and fallback.",
  "type": "module",
  "bin": {
    "oai-tts-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
